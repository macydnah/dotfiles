{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "plan",

  // "model": "opencode/big-pickle",
  // "small_model": "opencode/big-pickle",

  // "model": "github-copilot/gpt-5.4-mini",
  // "small_model": "github-copilot/claude-haiku-4.5",

  "model": "opencode-go/deepseek-v4-flash",
  // "small_model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode/deepseek-v4-flash-free",

  "share": "manual",
  "permission": {
    "bash": {
      // "git commit *": "deny",
      "git push *": "deny",
      "rm *": "deny"
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "color": "primary"
    },
    "build": {
      "mode": "primary",
      "model": "opencode-go/minimax-m2.7",
      "color": "secondary"
    },
    "general": {
      "mode": "all",
      "color": "warning"
    }
  },
  "provider": {
    "github-copilot": {
      // Keep blacklist (not whitelist) so newly exposed models remain visible by default.
      // https://docs.github.com/en/copilot/reference/ai-models/supported-models#supported-ai-models-per-copilot-plan
      "blacklist": [
        "claude-opus-4.5",
        "claude-opus-4.6",
        "claude-sonnet-4",
        "claude-sonnet-4.5",
        "claude-sonnet-4.6",
        "gpt-5.4"
      ]
    }
  },
  // "plugin": ["@opeoginni/opencode-copilot-auto"],
  "lsp": {
    "basedpyright": {
      "disabled": false,
      "command": [ "basedpyright-langserver", "--stdio" ],
      "extensions": [ ".py", ".pyi" ]
    }
  }
}
